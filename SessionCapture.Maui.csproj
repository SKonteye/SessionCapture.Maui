<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(SessionCaptureTargets)</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>SessionCapture.Maui</PackageId>
    <Title>SessionCapture.Maui</Title>
    <Description>Reusable MAUI session capture library with overlay-driven screenshots, local storage, and export APIs.</Description>
    <Version>1.0.0</Version>
    <Authors>SKonteye</Authors>
    <Copyright>Copyright (c) 2026 SKonteye</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>maui;android;ios;screenshot;testing;qa;bug-report;session-capture</PackageTags>

    <!-- Set these once the repository is published; nuget.org renders them as
         links, so pointing them at a repo that does not exist yet would ship a
         dead link on the package page.
    <PackageProjectUrl>https://github.com/SKonteye/SessionCapture.Maui</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SKonteye/SessionCapture.Maui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    -->

    <!-- Ship a symbol package and embed source-link metadata so consumers can
         step into the library when debugging their own app. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- The library lives at the repo root, so the SDK's default globs would other-
       wise pull samples/** into the shipped assembly. Keep them out. -->

  <ItemGroup>
    <Compile Remove="samples/**;tests/**" />
    <None Remove="samples/**;tests/**" />
    <MauiXaml Remove="samples/**;tests/**" />
    <EmbeddedResource Remove="samples/**;tests/**" />
    <AndroidResource Remove="samples/**;tests/**" />
    <BundleResource Remove="samples/**;tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <!-- 10.0.30 is a hard floor, not a preference. On 10.0.20 an iOS app dies at
         startup with a NullReferenceException in MauiCALayer.Dispose, raised on
         the finalizer thread from inside MAUI itself. Verified on the iOS 26.5
         simulator: identical app, 10.0.20 crashes, 10.0.30 runs. Lowering this
         to match an older workload ships a package that cannot start. -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.30" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.30" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
