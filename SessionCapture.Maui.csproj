<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(SessionCaptureTargets)</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>SessionCapture.Maui</PackageId>
    <Title>SessionCapture.Maui</Title>
    <Description>Reusable MAUI session capture library with overlay-driven screenshots, local storage, and export APIs.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- The library lives at the repo root, so the SDK's default globs would other-
       wise pull samples/** into the shipped assembly. Keep them out. -->

  <ItemGroup>
    <Compile Remove="samples/**" />
    <None Remove="samples/**" />
    <MauiXaml Remove="samples/**" />
    <EmbeddedResource Remove="samples/**" />
    <AndroidResource Remove="samples/**" />
    <BundleResource Remove="samples/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.30" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.30" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
