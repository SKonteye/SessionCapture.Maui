<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:SessionCapture.Sample"
       x:Class="SessionCapture.Sample.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Home"
                      ContentTemplate="{DataTemplate local:MainPage}"
                      Route="main" />
        <ShellContent Title="Form"
                      ContentTemplate="{DataTemplate local:FormPage}"
                      Route="form" />
        <ShellContent Title="Sessions"
                      ContentTemplate="{DataTemplate local:SessionsPage}"
                      Route="sessions" />
    </TabBar>

</Shell>
