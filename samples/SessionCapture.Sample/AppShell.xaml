<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:SessionCapture.Sample"
       xmlns:views="clr-namespace:SessionCapture.Maui.Views;assembly=SessionCapture.Maui"
       x:Class="SessionCapture.Sample.AppShell"
       Shell.FlyoutBehavior="Flyout"
       Title="SessionCapture">

    <ShellContent Title="Overview"
                  Icon="{OnPlatform iOS='house', Android='house'}"
                  ContentTemplate="{DataTemplate local:OverviewPage}"
                  Route="overview" />

    <ShellContent Title="1. Setup"
                  ContentTemplate="{DataTemplate local:SetupPage}"
                  Route="setup" />

    <ShellContent Title="2. Sessions"
                  ContentTemplate="{DataTemplate local:SessionsDocPage}"
                  Route="sessions-doc" />

    <ShellContent Title="3. Capturing"
                  ContentTemplate="{DataTemplate local:CapturingPage}"
                  Route="capturing" />

    <ShellContent Title="4. Auto-capture"
                  ContentTemplate="{DataTemplate local:AutoCapturePage}"
                  Route="auto-capture" />

    <ShellContent Title="5. Export"
                  ContentTemplate="{DataTemplate local:ExportPage}"
                  Route="export" />

    <ShellContent Title="6. Review"
                  ContentTemplate="{DataTemplate local:ReviewPage}"
                  Route="review" />

    <!-- Library code, not sample code: this is the page the package ships, so a
         reader sees exactly what one line of integration buys them. -->
    <ShellContent Title="Stored sessions"
                  ContentTemplate="{DataTemplate views:SessionCapturePage}"
                  Route="stored" />

</Shell>
