<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SessionCapture.Maui.Models;assembly=SessionCapture.Maui"
             x:Class="SessionCapture.Sample.SessionsPage"
             Title="Sessions">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">

        <Label Grid.Row="0" Text="Stored sessions" Style="{StaticResource Heading}" />

        <Button Grid.Row="1" Text="Reload" Clicked="OnReloadClicked" />

        <CollectionView Grid.Row="2" x:Name="SessionList">
            <CollectionView.EmptyView>
                <Label Text="No sessions stored yet." Style="{StaticResource Caption}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CapturedSession">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Text="{Binding StepCount, StringFormat='Steps: {0}'}"
                                   Style="{StaticResource Caption}" />
                            <Label Text="{Binding Id}" Style="{StaticResource Mono}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <Label x:Name="ResultLabel" Style="{StaticResource Mono}" />
            <Button Text="Export newest as ZIP" Clicked="OnExportClicked" />
            <Button Text="Share newest" Clicked="OnShareClicked" />
            <Button Text="Save newest to Photos" Clicked="OnSaveClicked" />
            <Button Text="Delete all" Clicked="OnDeleteAllClicked" Style="{StaticResource DangerButton}" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
