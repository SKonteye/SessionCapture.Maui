<?xml version="1.0" encoding="UTF-8" ?>
<local:DocPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SessionCapture.Sample"
             xmlns:models="clr-namespace:SessionCapture.Maui.Models;assembly=SessionCapture.Maui"
             x:Class="SessionCapture.Sample.StoredSessionsPage"
             Title="Stored sessions">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">

        <Label Grid.Row="0" Text="Stored sessions" Style="{StaticResource Heading}" />
        <Label Grid.Row="1" Style="{StaticResource Caption}"
               Text="Everything GetAllSessionsAsync returns, newest first. Tap a session to review its steps." />

        <CollectionView Grid.Row="2" x:Name="SessionList" Margin="0,6,0,0"
                        SelectionMode="Single"
                        SelectionChanged="OnSessionSelected">
            <CollectionView.EmptyView>
                <Label Text="No sessions recorded yet." Style="{StaticResource Caption}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CapturedSession">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Style="{StaticResource Caption}"
                                   Text="{Binding StepCount, StringFormat='{0} step(s)'}" />
                            <Label Style="{StaticResource Caption}"
                                   Text="{Binding TesterName, StringFormat='tester: {0}'}" />
                            <Label Style="{StaticResource Mono}" Text="{Binding Id}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <Label x:Name="ResultLabel" Style="{StaticResource Mono}" />
            <Button Text="Reload" Clicked="OnReloadClicked" />
            <Button Text="Delete all" Clicked="OnDeleteAllClicked" Style="{StaticResource DangerButton}" />
        </VerticalStackLayout>

    </Grid>
</local:DocPage>
