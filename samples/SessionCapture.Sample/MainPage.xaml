<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SessionCapture.Sample.MainPage"
             Title="Home">
    <ScrollView>
        <VerticalStackLayout Spacing="14">

            <Label Text="SessionCapture POC" Style="{StaticResource Heading}" />
            <Label x:Name="RootModeLabel" Style="{StaticResource Caption}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Library state" FontAttributes="Bold" />
                    <Label x:Name="StateLabel" Style="{StaticResource Mono}" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="StartButton" Text="Start session" Clicked="OnStartClicked" />
            <Button x:Name="StopButton" Text="Stop session" Clicked="OnStopClicked" Style="{StaticResource DangerButton}" />
            <Button Text="Manual capture" Clicked="OnCaptureClicked" />
            <Button Text="Capture with note" Clicked="OnCaptureNoteClicked" />

            <Label Text="Navigate (triggers auto-capture)" FontAttributes="Bold" Margin="0,8,0,0" />
            <Button Text="Go to Form page" Clicked="OnGoFormClicked" />
            <Button Text="Go to Detail page" Clicked="OnGoDetailClicked" />

            <Label Text="Root layout" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label Text="Switch to NavigationPage to test the non-Shell path."
                   Style="{StaticResource Caption}" />
            <Button x:Name="SwitchRootButton" Text="Switch root mode" Clicked="OnSwitchRootClicked" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Event log" FontAttributes="Bold" />
                    <Label x:Name="LogLabel" Style="{StaticResource Mono}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
