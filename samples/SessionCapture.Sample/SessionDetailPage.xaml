<?xml version="1.0" encoding="UTF-8" ?>
<local:DocPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SessionCapture.Sample"
             x:Class="SessionCapture.Sample.SessionDetailPage"
             Title="Session">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">

        <VerticalStackLayout Grid.Row="0" Spacing="3">
            <Label x:Name="SessionName" Style="{StaticResource Heading}" />
            <Label x:Name="SessionMeta" Style="{StaticResource MetaRow}" />
            <Label x:Name="SessionDevice" Style="{StaticResource MetaRow}" />
            <Label x:Name="SessionIdLabel" Style="{StaticResource Mono}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" x:Name="StepList" Margin="0,6,0,0">
            <CollectionView.EmptyView>
                <Label Text="This session recorded no steps."
                       Style="{StaticResource Caption}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:StepView">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                            <Image Grid.Column="0"
                                   Style="{StaticResource StepThumb}"
                                   Source="{Binding ImagePath}" />

                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Style="{StaticResource StepNumber}"
                                       Text="{Binding Heading}" />
                                <Label Text="{Binding PageName}" FontAttributes="Bold" />
                                <Label Style="{StaticResource Caption}"
                                       Text="{Binding Timestamp}" />
                                <Label Style="{StaticResource Caption}"
                                       Text="{Binding ViewModelName}"
                                       IsVisible="{Binding HasViewModel}" />
                                <Label Style="{StaticResource StepNote}"
                                       Text="{Binding UserNote}"
                                       IsVisible="{Binding HasNote}" />
                                <Label Style="{StaticResource Caption}"
                                       Text="screenshot missing"
                                       IsVisible="{Binding IsMissingImage}" />
                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Label x:Name="ResultLabel" Style="{StaticResource Mono}" />
            <Button Text="Export as ZIP" Clicked="OnExportClicked" />
            <Button Text="Share" Clicked="OnShareClicked" />
            <Button Text="Save to photos" Clicked="OnSaveClicked" />
            <Button Text="Delete this session" Clicked="OnDeleteClicked"
                    Style="{StaticResource DangerButton}" />
        </VerticalStackLayout>

    </Grid>
</local:DocPage>
