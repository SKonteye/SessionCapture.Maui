<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SessionCapture.Sample.App">
    <Application.Resources>
        <ResourceDictionary>

            <Color x:Key="Primary">#512BD4</Color>
            <Color x:Key="Danger">#C2185B</Color>
            <Color x:Key="Muted">#6E6E6E</Color>
            <Color x:Key="CardBg">#F4F4F6</Color>

            <Style TargetType="Page" ApplyToDerivedTypes="True">
                <Setter Property="Padding" Value="20" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="#1A1A1A" />
            </Style>

            <Style x:Key="Heading" TargetType="Label">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="Caption" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource Muted}" />
            </Style>

            <Style x:Key="Mono" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="Courier New" />
                <Setter Property="TextColor" Value="#1A1A1A" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            </Style>

            <!-- Documentation styles -->

            <Color x:Key="CodeBg">#1E1E2E</Color>
            <Color x:Key="CodeFg">#E4E4EF</Color>
            <Color x:Key="NoteBg">#FFF4E5</Color>
            <Color x:Key="NoteAccent">#B26A00</Color>

            <Style x:Key="CodeBlock" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource CodeBg}" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="Code" TargetType="Label">
                <Setter Property="FontFamily" Value="Courier New" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource CodeFg}" />
                <Setter Property="LineHeight" Value="1.35" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,10,0,2" />
            </Style>

            <Style x:Key="Body" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="LineHeight" Value="1.4" />
            </Style>

            <Style x:Key="NoteCard" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource NoteBg}" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="NoteText" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource NoteAccent}" />
                <Setter Property="LineHeight" Value="1.35" />
            </Style>

            <Style x:Key="DemoCard" TargetType="Border">
                <Setter Property="BackgroundColor" Value="#EEF0FF" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            </Style>

            <Style x:Key="DemoLabel" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
            </Style>

            <!-- Session review styles -->

            <Color x:Key="ThumbBg">#DDDDE3</Color>

            <!-- Screenshots are portrait phone captures; 64x114 keeps that
                 ratio so the thumbnail is not letterboxed in the step list. -->
            <Style x:Key="StepThumb" TargetType="Image">
                <Setter Property="WidthRequest" Value="64" />
                <Setter Property="HeightRequest" Value="114" />
                <Setter Property="Aspect" Value="AspectFit" />
                <Setter Property="BackgroundColor" Value="{StaticResource ThumbBg}" />
            </Style>

            <Style x:Key="StepNumber" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
            </Style>

            <Style x:Key="StepNote" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource NoteAccent}" />
                <Setter Property="LineHeight" Value="1.3" />
            </Style>

            <Style x:Key="MetaRow" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource Muted}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
