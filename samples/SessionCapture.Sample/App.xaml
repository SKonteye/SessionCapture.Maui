<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SessionCapture.Sample.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Light / dark pairs. Every colour used in a style below is
                 applied with AppThemeBinding, so the docs stay readable when
                 the device switches theme. -->

            <Color x:Key="PrimaryLight">#512BD4</Color>
            <Color x:Key="PrimaryDark">#B9A3FF</Color>

            <Color x:Key="DangerLight">#C2185B</Color>
            <Color x:Key="DangerDark">#F06292</Color>

            <Color x:Key="MutedLight">#6E6E6E</Color>
            <Color x:Key="MutedDark">#AAAAAF</Color>

            <Color x:Key="CardBgLight">#F4F4F6</Color>
            <Color x:Key="CardBgDark">#2A2A30</Color>

            <Color x:Key="PageBgLight">#FFFFFF</Color>
            <Color x:Key="PageBgDark">#1C1C1F</Color>

            <Color x:Key="TextLight">#1A1A1A</Color>
            <Color x:Key="TextDark">#ECECEF</Color>

            <!-- The code block is dark in both themes: it reads as a terminal,
                 and its foreground already contrasts against that background. -->
            <Color x:Key="CodeBg">#1E1E2E</Color>
            <Color x:Key="CodeFg">#E4E4EF</Color>

            <Color x:Key="NoteBgLight">#FFF4E5</Color>
            <Color x:Key="NoteBgDark">#3A2F1C</Color>

            <Color x:Key="NoteAccentLight">#B26A00</Color>
            <Color x:Key="NoteAccentDark">#E0A44A</Color>

            <Color x:Key="DemoBgLight">#EEF0FF</Color>
            <Color x:Key="DemoBgDark">#26263A</Color>

            <Style TargetType="Page" ApplyToDerivedTypes="True">
                <Setter Property="Padding" Value="20" />
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}" />
            </Style>

            <!-- The flyout draws its own surface, so it needs the page colours
                 restated: without this its items render dark-on-dark. -->
            <Style TargetType="Shell" ApplyToDerivedTypes="True">
                <Setter Property="Shell.BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}" />
                <Setter Property="Shell.ForegroundColor"
                        Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                <Setter Property="Shell.TitleColor"
                        Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                <Setter Property="Shell.UnselectedColor"
                        Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                <Setter Property="Shell.DisabledColor"
                        Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
            </Style>

            <Style x:Key="Heading" TargetType="Label">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
            </Style>

            <Style x:Key="Caption" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
            </Style>

            <Style x:Key="Mono" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="Courier New" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=White, Dark=#1A1A1A}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=White, Dark=#1A1A1A}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            </Style>

            <!-- Documentation styles -->

            <Style x:Key="CodeBlock" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource CodeBg}" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="Code" TargetType="Label">
                <Setter Property="FontFamily" Value="Courier New" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource CodeFg}" />
                <Setter Property="LineHeight" Value="1.35" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,10,0,2" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
            </Style>

            <Style x:Key="Body" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="LineHeight" Value="1.4" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
            </Style>

            <Style x:Key="NoteCard" TargetType="Border">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource NoteBgLight}, Dark={StaticResource NoteBgDark}}" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="NoteText" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource NoteAccentLight}, Dark={StaticResource NoteAccentDark}}" />
                <Setter Property="LineHeight" Value="1.35" />
            </Style>

            <Style x:Key="DemoCard" TargetType="Border">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource DemoBgLight}, Dark={StaticResource DemoBgDark}}" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            </Style>

            <Style x:Key="DemoLabel" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
